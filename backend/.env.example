PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ags_platform

JWT_SECRET=replace-with-a-long-random-string

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000

# Supabase Storage (Phase 9) — leave blank to use the local-disk fallback (see lib/storage.ts)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Base URL this server is reachable at, used to build absolute URLs for locally-stored files
PUBLIC_URL=http://localhost:4000

# Resend email (Phase 10) — leave blank to log emails to the console instead (see lib/email.ts)
RESEND_API_KEY=
RESEND_FROM_EMAIL=AGS <onboarding@resend.dev>

# Google OAuth sign-in/sign-up
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Python FastAPI service (Phase 11)
PYTHON_SERVICE_URL=http://localhost:8000
